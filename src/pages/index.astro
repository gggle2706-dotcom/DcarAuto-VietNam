---
import Layout from '@/layouts/Layout.astro';
import AutoModStudio from '@/components/AutoModStudio';
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';
---

<Layout
  title={`Dcar Auto Vietnam - Trung Tâm Phối Đồ & Cấu Hình Độ Xe Chuyên Nghiệp`}
  description={`Tự chọn màn hình android, camera 360, độ đèn bi LED, âm thanh và phụ kiện chuẩn giắc zin 100% theo xe. Nhận báo giá trọn gói trực tiếp qua Zalo kỹ thuật viên.`}
>
  <!-- 1. AUTO MOD STUDIO: TRUNG TÂM CẤU HÌNH & INBOX ZALO 3 CỘT (GIAO DIỆN SÁNG CHỦ ĐẠO) -->
  <section class="bg-slate-100/70 border-b border-slate-200">
    <AutoModStudio client:load />
  </section>

  <!-- 2. CAM KẾT VÀNG TỪ DCAR AUTO VIETNAM (GIAO DIỆN SÁNG, TINH TẾ) -->
  <section class="py-10 px-4 sm:px-6 bg-white border-b border-slate-200 text-slate-800">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex items-start gap-3 hover:border-emerald-300 transition">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 font-black text-lg flex items-center justify-center shrink-0 border border-emerald-200">
            ✓
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-xs sm:text-sm">100% Giắc Zin Theo Xe</h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Không cắt trích 1 sợi dây điện, giữ trọn bảo hành hãng.</p>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex items-start gap-3 hover:border-blue-300 transition">
          <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 font-black text-lg flex items-center justify-center shrink-0 border border-blue-200">
            🛡️
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-xs sm:text-sm">Bảo Hành 12 - 36 Tháng</h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Lỗi 1 đổi 1 nhanh chóng, kích hoạt bảo hành điện tử chính hãng.</p>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex items-start gap-3 hover:border-amber-300 transition">
          <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-700 font-black text-lg flex items-center justify-center shrink-0 border border-amber-200">
            🚗
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-xs sm:text-sm">Lắp Đặt Tận Nơi</h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Hỗ trợ kỹ thuật viên thi công tại nhà hoặc tại xưởng chuyên nghiệp.</p>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex items-start gap-3 hover:border-red-300 transition">
          <div class="w-10 h-10 rounded-lg bg-red-100 text-red-600 font-black text-lg flex items-center justify-center shrink-0 border border-red-200">
            💬
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-xs sm:text-sm">Tư Vấn Zalo 24/7</h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Kỹ thuật viên trực tiếp phản hồi, báo giá minh bạch trọn gói.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. KHUNG LIÊN HỆ & BÁO GIÁ TRỰC TIẾP (SÁNG SỦA, CAO CẤP) -->
  <section class="py-12 px-4 sm:px-6 bg-slate-50 text-center">
    <div class="max-w-3xl mx-auto space-y-4">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
        Bạn Cần Tư Vấn Riêng Cho Dòng Xe Của Mình?
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        Hãy chụp ảnh bảng điều khiển taplo xe hoặc nhắn tên xe qua Zalo, kỹ thuật viên Dcar Auto sẽ gửi ảnh mặt dưỡng thực tế và báo giá trọn gói cắm giắc zin.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href={`https://zalo.me/${DEFAULT_SHOP_SETTINGS.zalo.replace(/[^0-9]/g, '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-xl bg-[#0068FF] hover:bg-[#0054cc] text-white font-extrabold text-xs shadow-lg shadow-blue-500/20 transition flex items-center gap-2 active:scale-95"
        >
          <span>Nhắn Zalo Kỹ Thuật Viên:</span>
          <span>{DEFAULT_SHOP_SETTINGS.zalo}</span>
        </a>
        <a
          href={`tel:${DEFAULT_SHOP_SETTINGS.phone.replace(/[^0-9]/g, '')}`}
          class="px-6 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-extrabold text-xs border border-slate-300 transition flex items-center gap-2 active:scale-95 shadow-xs"
        >
          <span>Gọi Hotline:</span>
          <span>{DEFAULT_SHOP_SETTINGS.phone}</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
