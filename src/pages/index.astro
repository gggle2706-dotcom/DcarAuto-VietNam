---
import Layout from '@/layouts/Layout.astro';
import CarSelectorWidget from '@/components/CarSelectorWidget';
import ProductCard from '@/components/ProductCard.astro';
import { CATEGORIES_LIST, CAR_BRANDS_SAMPLE, DEFAULT_SHOP_SETTINGS } from '@/lib/constants';
import { MOCK_PRODUCTS } from '@/lib/mock-products';

const featuredProducts = MOCK_PRODUCTS.filter((p) => p.isFeatured).slice(0, 8);
---

<Layout>
  <!-- 1. Hero Section đơn giản, thực tế -->
  <section class="bg-neutral-950 py-10 sm:py-16 px-4 sm:px-6 border-b border-neutral-800">
    <div class="max-w-6xl mx-auto text-center space-y-4">
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Nâng Cấp Phụ Kiện & Đồ Chơi Công Nghệ Ô Tô
      </h1>

      <p class="text-xs sm:text-sm text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        Phân phối và lắp đặt Màn hình Android, Camera 360, Âm thanh, Độ đèn Bi LED, Cảm biến áp suất lốp chuẩn giắc zin 100% theo từng đời xe.
      </p>

      <!-- Widget Tra cứu theo xe -->
      <div class="pt-2">
        <CarSelectorWidget client:load />
      </div>

      <!-- 4 Cam kết ngắn gọn -->
      <div class="pt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl mx-auto text-left text-xs text-neutral-400">
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>100% Cắm giắc zin theo xe</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Bảo hành chính hãng 12 - 36 tháng</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Hỗ trợ kỹ thuật trọn đời</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Hỗ trợ lắp đặt tận nơi</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Danh mục Nâng Cấp Nổi Bật -->
  <section class="py-10 px-4 sm:px-6 max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg sm:text-xl font-bold text-white">Danh Mục Sản Phẩm</h2>
      <a href="/san-pham" class="text-xs text-neutral-400 hover:text-white transition">
        Xem tất cả →
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {CATEGORIES_LIST.map((cat) => (
        <a
          href={`/san-pham?category=${cat.slug}`}
          class="p-4 rounded-lg bg-neutral-900 border border-neutral-800 hover:border-neutral-700 transition flex flex-col justify-between"
        >
          <div class="font-semibold text-white text-sm">
            {cat.name}
          </div>
          <span class="text-[11px] text-neutral-400 mt-2">Xem phụ kiện →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. Sản Phẩm Bán Chạy / Nổi Bật -->
  <section class="py-10 px-4 sm:px-6 bg-neutral-900/40 border-y border-neutral-800">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-white">Sản Phẩm Được Lắp Đặt Nhiều Nhất</h2>
          <p class="text-xs text-neutral-400 mt-0.5">Sản phẩm chính hãng, đầy đủ mặt dưỡng zin và canbus</p>
        </div>
        <a href="/san-pham" class="text-xs text-neutral-400 hover:text-white transition">
          Xem toàn bộ ({MOCK_PRODUCTS.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {featuredProducts.map((prod) => (
          <ProductCard
            id={prod.id}
            slug={prod.slug}
            name={prod.name}
            brand={prod.brand}
            categoryName={prod.categoryName}
            price={prod.price}
            salePrice={prod.salePrice}
            image={prod.image}
            specs={prod.specs}
            warrantyMonths={prod.warrantyMonths}
            isUniversal={prod.isUniversal}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Lựa Chọn Theo Hãng Xe -->
  <section class="py-10 px-4 sm:px-6 max-w-7xl mx-auto">
    <div class="text-center max-w-xl mx-auto mb-6">
      <h2 class="text-lg sm:text-xl font-bold text-white">Tra Cứu Theo Hãng Xe Của Bạn</h2>
      <p class="text-xs text-neutral-400 mt-1">Bấm chọn hãng xe để xem ngay toàn bộ phụ kiện tương thích</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2.5">
      {CAR_BRANDS_SAMPLE.map((brand) => (
        <a
          href={`/tim-theo-xe?brand=${brand.slug}`}
          class="p-3 rounded-lg bg-neutral-900 border border-neutral-800 hover:border-neutral-600 text-center transition flex flex-col items-center justify-center gap-1.5"
        >
          <div class="w-8 h-8 rounded-full bg-neutral-800 text-white font-bold text-xs flex items-center justify-center">
            {brand.name[0]}
          </div>
          <span class="font-medium text-xs text-neutral-200">
            {brand.name}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 5. Khung Liên Hệ & Báo Giá Thực Tế -->
  <section class="py-10 px-4 sm:px-6 bg-neutral-900 border-t border-neutral-800">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-white">
        Bạn Chưa Rõ Xe Của Mình Lắp Được Những Gì?
      </h2>
      <p class="text-xs sm:text-sm text-neutral-400 max-w-xl mx-auto">
        Hãy chụp ảnh bảng điều khiển hoặc nhắn tên dòng xe qua Zalo, kỹ thuật viên sẽ tư vấn cụ thể loại màn hình, mặt dưỡng và báo giá trọn gói thi công.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href={`https://zalo.me/${DEFAULT_SHOP_SETTINGS.zalo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs transition"
        >
          Nhắn Zalo Kỹ Thuật Viên ({DEFAULT_SHOP_SETTINGS.zalo})
        </a>
        <a
          href={`tel:${DEFAULT_SHOP_SETTINGS.phone.replace(/[^0-9]/g, '')}`}
          class="px-5 py-2.5 rounded bg-neutral-800 hover:bg-neutral-700 text-white font-bold text-xs border border-neutral-700 transition"
        >
          Gọi Hotline: {DEFAULT_SHOP_SETTINGS.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>
