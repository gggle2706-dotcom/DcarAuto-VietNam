---
import Layout from '@/layouts/Layout.astro';
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';
---

<Layout
  title={`Liên Hệ & Đặt Lịch Lắp Đặt - ${DEFAULT_SHOP_SETTINGS.shop_name}`}
  description={`Thông tin liên hệ xưởng độ xe ${DEFAULT_SHOP_SETTINGS.shop_name}: Số điện thoại, Zalo, địa chỉ gara tại ${DEFAULT_SHOP_SETTINGS.address}, chỉ đường Google Maps.`}
>
  <div class="bg-slate-100 border-b border-slate-200 py-8 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">
      <nav class="text-xs text-slate-500 mb-2 flex items-center gap-2">
        <a href="/" class="hover:text-slate-900">Trang chủ</a>
        <span>/</span>
        <span class="text-red-600 font-medium">Liên hệ</span>
      </nav>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Liên Hệ & Đặt Lịch Lắp Đặt
      </h1>
      <p class="text-slate-600 text-xs sm:text-sm mt-1 max-w-2xl">
        Chúng tôi luôn sẵn sàng tư vấn giải pháp nâng cấp đồ chơi ô tô tối ưu và chuẩn xác nhất cho xe của bạn.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      <!-- Thông tin liên hệ -->
      <div class="space-y-6">
        <div>
          <h2 class="text-lg font-bold text-slate-900 mb-3">Thông Tin Xưởng</h2>
          <div class="space-y-3 text-xs text-slate-700">
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
              <span class="text-base">📍</span>
              <div>
                <div class="font-bold text-slate-900">Địa chỉ xưởng</div>
                <div class="text-slate-600 mt-0.5 shop-address-val">{DEFAULT_SHOP_SETTINGS.address}</div>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
              <span class="text-base">📞</span>
              <div>
                <div class="font-bold text-slate-900">Hotline tư vấn</div>
                <a href={`tel:${DEFAULT_SHOP_SETTINGS.phone.replace(/[^0-9]/g, '')}`} class="shop-phone-link text-red-600 font-bold mt-0.5 block hover:underline">
                  <span class="shop-phone-val">{DEFAULT_SHOP_SETTINGS.phone}</span>
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
              <span class="text-base font-bold text-blue-600">Z</span>
              <div>
                <div class="font-bold text-slate-900">Zalo kỹ thuật</div>
                <a href={`https://zalo.me/${DEFAULT_SHOP_SETTINGS.zalo}`} target="_blank" rel="noopener noreferrer" class="shop-zalo-link text-blue-600 font-bold mt-0.5 block hover:underline">
                  <span class="shop-zalo-val">{DEFAULT_SHOP_SETTINGS.zalo}</span> (Hỗ trợ nhanh)
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
              <span class="text-base">⏰</span>
              <div>
                <div class="font-bold text-slate-900">Thời gian làm việc</div>
                <div class="text-slate-600 mt-0.5 shop-hours-val">{DEFAULT_SHOP_SETTINGS.operating_hours}</div>
              </div>
            </div>

            <!-- Các kênh mạng xã hội -->
            <div class="grid grid-cols-3 gap-2.5 pt-1">
              <a
                href={DEFAULT_SHOP_SETTINGS.facebook_url}
                target="_blank"
                rel="noopener noreferrer"
                class="shop-facebook-link p-3 rounded-xl bg-white border border-slate-200 hover:border-blue-600 flex flex-col items-center justify-center gap-1.5 text-center shadow-2xs group transition"
              >
                <svg class="w-5 h-5 fill-blue-600" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                <span class="font-bold text-slate-800 group-hover:text-blue-600 text-[11px]">Facebook</span>
              </a>

              <a
                href={DEFAULT_SHOP_SETTINGS.tiktok_url}
                target="_blank"
                rel="noopener noreferrer"
                class="shop-tiktok-link p-3 rounded-xl bg-white border border-slate-200 hover:border-slate-900 flex flex-col items-center justify-center gap-1.5 text-center shadow-2xs group transition"
              >
                <svg class="w-5 h-5 fill-slate-900" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                <span class="font-bold text-slate-800 group-hover:text-slate-900 text-[11px]">TikTok</span>
              </a>

              <a
                href={DEFAULT_SHOP_SETTINGS.youtube_url}
                target="_blank"
                rel="noopener noreferrer"
                class="shop-youtube-link p-3 rounded-xl bg-white border border-slate-200 hover:border-red-600 flex flex-col items-center justify-center gap-1.5 text-center shadow-2xs group transition"
              >
                <svg class="w-5 h-5 fill-red-600" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                <span class="font-bold text-slate-800 group-hover:text-red-600 text-[11px]">YouTube</span>
              </a>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-xl bg-red-50 border border-red-200 space-y-2 text-xs">
          <div class="font-bold text-red-900 text-sm">Hỗ Trợ Lắp Đặt Tận Nơi</div>
          <p class="text-red-800 leading-relaxed">
            Nếu bạn không có thời gian mang xe qua xưởng, chúng tôi có đội ngũ kỹ thuật hỗ trợ thi công tận nhà hoặc cơ quan tại các khu vực nội thành.
          </p>
        </div>
      </div>

      <!-- Form gửi yêu cầu -->
      <div class="p-6 rounded-xl bg-white border border-slate-200 shadow-sm text-xs">
        <h2 class="text-base font-bold text-slate-900 mb-1">Gửi Yêu Cầu Báo Giá / Đặt Lịch</h2>
        <p class="text-slate-500 mb-5">
          Điền thông tin dòng xe, chúng tôi sẽ liên hệ lại qua Zalo hoặc điện thoại trong 15 phút.
        </p>

        <form action={`https://zalo.me/${DEFAULT_SHOP_SETTINGS.zalo}`} target="_blank" class="space-y-3.5">
          <div>
            <label class="block font-semibold text-slate-700 mb-1">Họ tên của bạn</label>
            <input
              type="text"
              required
              placeholder="Anh Tuấn"
              class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-slate-900 focus:outline-none focus:border-red-600 focus:bg-white"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Số điện thoại / Zalo *</label>
              <input
                type="tel"
                required
                placeholder="09xx.xxx.xxx"
                class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-slate-900 focus:outline-none focus:border-red-600 focus:bg-white"
              />
            </div>
            <div>
              <label class="block font-semibold text-slate-700 mb-1">Dòng xe & Đời xe *</label>
              <input
                type="text"
                required
                placeholder="Ví dụ: Vios 2021"
                class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-slate-900 focus:outline-none focus:border-red-600 focus:bg-white"
              />
            </div>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-1">Phụ kiện cần tư vấn</label>
            <select class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-slate-900 focus:outline-none focus:border-red-600 focus:bg-white">
              <option value="man-hinh">Màn hình Android / Android Box</option>
              <option value="cam-360">Camera 360 độ toàn cảnh</option>
              <option value="bi-led">Độ đèn Bi LED tăng sáng</option>
              <option value="am-thanh">Nâng cấp Loa Sub gầm ghế</option>
              <option value="khac">Phụ kiện & Đồ chơi khác</option>
            </select>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-1">Ghi chú thêm</label>
            <textarea
              rows="3"
              placeholder="Yêu cầu cụ thể của bạn..."
              class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-slate-900 focus:outline-none focus:border-red-600 focus:bg-white"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-2.5 px-4 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition shadow-xs"
          >
            Gửi Yêu Cầu Báo Giá
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
