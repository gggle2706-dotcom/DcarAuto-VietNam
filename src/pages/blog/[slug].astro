---
import Layout from '@/layouts/Layout.astro';
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';
import { MOCK_POSTS, type MockPost } from '@/lib/mock-posts';

export function getStaticPaths() {
  return MOCK_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: MockPost;
}

const { post } = Astro.props;
---

<Layout
  title={`${post.title} - ${DEFAULT_SHOP_SETTINGS.shop_name}`}
  description={post.excerpt}
>
  <div class="bg-slate-100 border-b border-slate-200 py-3 px-4 sm:px-6 text-xs text-slate-500">
    <div class="max-w-4xl mx-auto flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-slate-900">Trang chủ</a>
      <span>/</span>
      <a href="/blog" class="hover:text-slate-900">Kinh nghiệm</a>
      <span>/</span>
      <span class="text-slate-900 font-medium truncate">{post.title}</span>
    </div>
  </div>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <header class="mb-6 space-y-2">
      <span class="inline-block px-2.5 py-0.5 rounded text-xs font-semibold bg-red-50 text-red-600 border border-red-200">
        {post.category}
      </span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug">
        {post.title}
      </h1>
      <div class="text-xs text-slate-500">
        Ngày đăng: {post.publishedAt} • Tác giả: {post.author}
      </div>
    </header>

    <div class="aspect-video rounded-xl overflow-hidden mb-8 border border-slate-200 shadow-sm bg-slate-100">
      <img src={post.image} alt={post.title} class="w-full h-full object-cover" />
    </div>

    <div class="text-slate-700 text-sm leading-relaxed whitespace-pre-line space-y-4">
      {post.content}
    </div>

    <!-- CTA tư vấn trong bài viết -->
    <div class="mt-10 p-5 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs">
        <div class="font-bold text-slate-900 text-sm mb-0.5">Bạn Cần Tư Vấn Cho Xe Của Mình?</div>
        <div class="text-slate-600">Gửi tên dòng xe qua Zalo để kỹ thuật viên kiểm tra mã màn hình và mặt dưỡng phù hợp.</div>
      </div>
      <a
        href={`https://zalo.me/${DEFAULT_SHOP_SETTINGS.zalo}`}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs transition"
      >
        Nhắn Zalo Kỹ Thuật
      </a>
    </div>
  </article>
</Layout>
