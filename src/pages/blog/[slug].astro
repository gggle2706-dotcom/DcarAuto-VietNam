---
import Layout from '@/layouts/Layout.astro';
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';
import { MOCK_POSTS, type MockPost } from '@/lib/mock-posts';

export function getStaticPaths() {
  return MOCK_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: MockPost;
}

const { post } = Astro.props;
---

<Layout
  title={`${post.title} - AutoTech Pro`}
  description={post.excerpt}
>
  <div class="bg-slate-900/60 border-b border-slate-800 py-3 px-4 sm:px-6 text-xs text-slate-400">
    <div class="max-w-4xl mx-auto flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-white">Trang chủ</a>
      <span>/</span>
      <a href="/blog" class="hover:text-white">Kinh nghiệm</a>
      <span>/</span>
      <span class="text-amber-400 font-medium truncate">{post.title}</span>
    </div>
  </div>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <header class="mb-8 space-y-3 text-center sm:text-left">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 uppercase">
        {post.category}
      </span>
      <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-snug">
        {post.title}
      </h1>
      <div class="text-xs text-slate-400">
        Đăng ngày: {post.publishedAt} • Tác giả: <span class="text-slate-200">{post.author}</span>
      </div>
    </header>

    <div class="relative aspect-video rounded-2xl overflow-hidden mb-10 border border-slate-800 shadow-xl">
      <img src={post.image} alt={post.title} class="w-full h-full object-cover" />
    </div>

    <!-- Nội dung bài viết -->
    <div class="prose prose-invert max-w-none text-slate-300 text-sm sm:text-base leading-relaxed whitespace-pre-line space-y-4">
      {post.content}
    </div>

    <!-- CTA Box trong bài viết -->
    <div class="mt-12 p-6 rounded-2xl bg-gradient-to-r from-slate-900 to-slate-950 border border-amber-500/30 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
      <div>
        <h2 class="text-lg font-bold text-white mb-1">Cần Tư Vấn Trực Tiếp Cho Xe Của Bạn?</h2>
        <p class="text-xs text-slate-400">
          Chụp ảnh bảng điều khiển hoặc nhắn tên dòng xe qua Zalo để kỹ thuật viên tư vấn phương án cắm giắc zin 100%.
        </p>
      </div>
      <a
        href={`https://zalo.me/${DEFAULT_SHOP_SETTINGS.zalo}`}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs transition"
      >
        Chat Zalo Với Kỹ Thuật Viên
      </a>
    </div>
  </article>
</Layout>
