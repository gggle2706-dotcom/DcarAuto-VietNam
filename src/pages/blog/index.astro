---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';
import { MOCK_POSTS } from '@/lib/mock-posts';
import { parseVideoUrl } from '@/lib/video-helpers';
---

<Layout
  title={`Kinh Nghiệm & Tư Vấn Nâng Cấp Ô Tô - ${DEFAULT_SHOP_SETTINGS.shop_name}`}
  description="Chia sẻ kiến thức thực tế về màn hình Android, độ đèn bi LED văn minh, nâng cấp âm thanh và phụ kiện ô tô chuẩn zin."
>
  <div class="bg-slate-100 border-b border-slate-200 py-8 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">
      <nav class="text-xs text-slate-500 mb-2 flex items-center gap-2">
        <a href="/" class="hover:text-slate-900">Trang chủ</a>
        <span>/</span>
        <span class="text-red-600 font-medium">Kinh nghiệm & Tư vấn</span>
      </nav>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Kinh Nghiệm & Cẩm Nang Nâng Cấp Ô Tô
      </h1>
      <p class="text-slate-600 text-xs sm:text-sm mt-1 max-w-2xl">
        Các bài viết tư vấn từ đội ngũ thợ giúp bạn lựa chọn giải pháp nâng cấp xe phù hợp và tiết kiệm nhất.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <!-- Thanh Lọc Chuyên Mục & Video -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-8 pb-4 border-b border-slate-200">
      <div class="flex flex-wrap items-center gap-2 text-xs" id="blog-filter-tabs">
        <button data-cat="all" class="blog-tab-btn px-3 py-1.5 rounded-lg bg-red-600 text-white font-bold transition">
          Tất cả bài viết
        </button>
        <button data-cat="Tư vấn mua hàng" class="blog-tab-btn px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium transition">
          Tư vấn mua hàng
        </button>
        <button data-cat="Kinh nghiệm độ xe" class="blog-tab-btn px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium transition">
          Kinh nghiệm độ xe
        </button>
        <button data-cat="Kiến thức kỹ thuật" class="blog-tab-btn px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium transition">
          Kiến thức kỹ thuật
        </button>
        <button data-cat="video" class="blog-tab-btn px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium transition flex items-center gap-1.5">
          <span class="text-red-600">▶</span>
          <span>Có Video Thực Tế</span>
        </button>
      </div>

      <div class="text-xs text-slate-500">
        Hiển thị <strong id="blog-count" class="text-slate-900">{MOCK_POSTS.length}</strong> bài viết
      </div>
    </div>

    <!-- Grid Danh Sách Bài Viết -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="blog-posts-grid">
      {MOCK_POSTS.map((post) => {
        const video = parseVideoUrl(post.videoUrl);
        return (
          <article
            class="blog-post-card flex flex-col rounded-xl bg-white border border-slate-200 hover:border-slate-300 hover:shadow-md transition overflow-hidden group"
            data-category={post.category}
            data-has-video={video ? 'true' : 'false'}
          >
            <a href={`/blog/${post.slug}`} class="relative aspect-video overflow-hidden bg-slate-100 block">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-103 transition duration-300"
              />
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded text-[11px] font-semibold bg-white/90 text-slate-800 border border-slate-200 shadow-2xs">
                {post.category}
              </span>

              {video && (
                <span class={`absolute bottom-2.5 left-2.5 px-2 py-0.5 rounded text-[10px] font-bold shadow-xs flex items-center gap-1 ${video.badgeBg}`}>
                  <span>▶</span>
                  <span>Video {video.platformName}</span>
                </span>
              )}
            </a>

            <div class="p-4 flex-1 flex flex-col justify-between text-xs">
              <div>
                <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1.5">
                  <span>Ngày: {post.publishedAt}</span>
                  {post.relatedCar && (
                    <span class="text-slate-600 font-semibold truncate max-w-[140px]">
                      🚗 {post.relatedCar}
                    </span>
                  )}
                </div>

                <h2 class="font-bold text-sm text-slate-900 group-hover:text-red-600 transition line-clamp-2 mb-2 leading-snug">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="text-slate-600 line-clamp-3 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>

              <div class="pt-3 border-t border-slate-100 mt-4 flex items-center justify-between">
                {post.relatedProductIds && post.relatedProductIds.length > 0 ? (
                  <span class="text-[11px] text-emerald-700 font-medium">
                    🛠️ {post.relatedProductIds.length} sản phẩm lắp đặt
                  </span>
                ) : (
                  <span class="text-[11px] text-slate-400">Tư vấn kỹ thuật</span>
                )}
                <a href={`/blog/${post.slug}`} class="text-red-600 hover:underline font-semibold flex items-center gap-1">
                  <span>Xem chi tiết</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <!-- Client-side hydration script: Cập nhật danh sách nếu admin thêm/sửa bài viết -->
  <script is:inline>
    (function () {
      try {
        const savedPostsRaw = localStorage.getItem('app_posts');
        let posts = [];
        if (savedPostsRaw) {
          posts = JSON.parse(savedPostsRaw);
        }

        const grid = document.getElementById('blog-posts-grid');
        const countEl = document.getElementById('blog-count');
        const tabs = document.querySelectorAll('.blog-tab-btn');

        function parseVideo(url) {
          if (!url) return null;
          const u = url.trim();
          if (u.match(/(?:youtu\.be\/|youtube\.com\/)/)) {
            return { name: 'YouTube', bg: 'bg-red-600 text-white' };
          }
          if (u.includes('tiktok.com')) {
            return { name: 'TikTok', bg: 'bg-slate-900 text-white' };
          }
          if (u.includes('facebook.com') || u.includes('fb.watch')) {
            return { name: 'Facebook', bg: 'bg-blue-600 text-white' };
          }
          return null;
        }

        function renderPosts(filtered) {
          if (!grid) return;
          if (countEl) countEl.textContent = filtered.length;

          if (filtered.length === 0) {
            grid.innerHTML = '<div class="col-span-3 py-12 text-center text-slate-500 text-xs bg-white rounded-xl border border-slate-200">Không có bài viết nào trong mục này.</div>';
            return;
          }

          grid.innerHTML = filtered.map(function (p) {
            const v = parseVideo(p.videoUrl);
            const videoBadge = v
              ? '<span class="absolute bottom-2.5 left-2.5 px-2 py-0.5 rounded text-[10px] font-bold shadow-xs flex items-center gap-1 ' + v.bg + '"><span>▶</span><span>Video ' + v.name + '</span></span>'
              : '';
            const carTag = p.relatedCar
              ? '<span class="text-slate-600 font-semibold truncate max-w-[140px]">🚗 ' + p.relatedCar + '</span>'
              : '';
            const prodsTag = (p.relatedProductIds && p.relatedProductIds.length > 0)
              ? '<span class="text-[11px] text-emerald-700 font-medium">🛠️ ' + p.relatedProductIds.length + ' sản phẩm lắp đặt</span>'
              : '<span class="text-[11px] text-slate-400">Tư vấn kỹ thuật</span>';

            return '<article class="blog-post-card flex flex-col rounded-xl bg-white border border-slate-200 hover:border-slate-300 hover:shadow-md transition overflow-hidden group">' +
              '<a href="/blog/' + p.slug + '" class="relative aspect-video overflow-hidden bg-slate-100 block">' +
                '<img src="' + (p.image || 'https://images.unsplash.com/photo-1550009158-9ebf69173e03?auto=format&fit=crop&w=800&q=80') + '" alt="' + p.title + '" class="w-full h-full object-cover group-hover:scale-103 transition duration-300" />' +
                '<span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded text-[11px] font-semibold bg-white/90 text-slate-800 border border-slate-200 shadow-2xs">' + p.category + '</span>' +
                videoBadge +
              '</a>' +
              '<div class="p-4 flex-1 flex flex-col justify-between text-xs">' +
                '<div>' +
                  '<div class="flex items-center justify-between text-[11px] text-slate-400 mb-1.5">' +
                    '<span>Ngày: ' + p.publishedAt + '</span>' +
                    carTag +
                  '</div>' +
                  '<h2 class="font-bold text-sm text-slate-900 group-hover:text-red-600 transition line-clamp-2 mb-2 leading-snug">' +
                    '<a href="/blog/' + p.slug + '">' + p.title + '</a>' +
                  '</h2>' +
                  '<p class="text-slate-600 line-clamp-3 leading-relaxed">' + (p.excerpt || '') + '</p>' +
                '</div>' +
                '<div class="pt-3 border-t border-slate-100 mt-4 flex items-center justify-between">' +
                  prodsTag +
                  '<a href="/blog/' + p.slug + '" class="text-red-600 hover:underline font-semibold flex items-center gap-1"><span>Xem chi tiết</span><span>→</span></a>' +
                '</div>' +
              '</div>' +
            '</article>';
          }).join('');
        }

        if (posts && posts.length > 0) {
          renderPosts(posts);
        }

        // Tab filter click
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            tabs.forEach(function (t) {
              t.className = 'blog-tab-btn px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium transition';
            });
            tab.className = 'blog-tab-btn px-3 py-1.5 rounded-lg bg-red-600 text-white font-bold transition';

            const activePosts = posts.length > 0 ? posts : Array.from(document.querySelectorAll('.blog-post-card'));
            const cat = tab.getAttribute('data-cat');

            if (posts.length > 0) {
              if (cat === 'all') {
                renderPosts(posts);
              } else if (cat === 'video') {
                renderPosts(posts.filter(function (p) { return Boolean(p.videoUrl && p.videoUrl.trim()); }));
              } else {
                renderPosts(posts.filter(function (p) { return p.category === cat; }));
              }
            } else {
              // DOM filter
              document.querySelectorAll('.blog-post-card').forEach(function (card) {
                const cardCat = card.getAttribute('data-category');
                const hasVideo = card.getAttribute('data-has-video') === 'true';
                if (cat === 'all' || (cat === 'video' && hasVideo) || cardCat === cat) {
                  card.style.display = 'flex';
                } else {
                  card.style.display = 'none';
                }
              });
            }
          });
        });
      } catch (e) {
        console.error('Blog index error:', e);
      }
    })();
  </script>
</Layout>
