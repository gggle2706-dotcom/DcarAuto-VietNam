---
import '../styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingContactBar from '@/components/FloatingContactBar.astro';
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';

interface Props {
  title?: string;
  description?: string;
  hideHeaderFooter?: boolean;
}

const {
  title = DEFAULT_SHOP_SETTINGS.seo_title,
  description = DEFAULT_SHOP_SETTINGS.seo_description,
  hideHeaderFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="vi" class="h-full bg-slate-50 text-slate-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OpenGraph SEO Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-full flex flex-col font-sans bg-slate-50 text-slate-900 selection:bg-red-600 selection:text-white">
    {!hideHeaderFooter && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {!hideHeaderFooter && <Footer />}
    {!hideHeaderFooter && <FloatingContactBar />}
  </body>
</html>
