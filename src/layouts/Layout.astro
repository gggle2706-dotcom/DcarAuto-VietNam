---
import '../styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingContactBar from '@/components/FloatingContactBar.astro';
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';

interface Props {
  title?: string;
  description?: string;
  hideHeaderFooter?: boolean;
}

const {
  title = DEFAULT_SHOP_SETTINGS.seo_title,
  description = DEFAULT_SHOP_SETTINGS.seo_description,
  hideHeaderFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="vi" class="h-full bg-slate-50 text-slate-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OpenGraph SEO Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-full flex flex-col font-sans bg-slate-50 text-slate-900 selection:bg-red-600 selection:text-white">
    {!hideHeaderFooter && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {!hideHeaderFooter && <Footer />}
    {!hideHeaderFooter && <FloatingContactBar />}

    <!-- Script tự động đồng bộ cấu hình cửa hàng từ Admin (localStorage) theo thời gian thực -->
    <script is:inline>
      function syncShopSettings() {
        try {
          var raw = localStorage.getItem('app_shop_settings');
          if (!raw) return;
          var settings = JSON.parse(raw);
          if (!settings) return;

          if (settings.shop_name) {
            document.querySelectorAll('.shop-name-val').forEach(function(el) {
              el.textContent = settings.shop_name;
            });
            document.querySelectorAll('.shop-logo-fallback').forEach(function(el) {
              el.textContent = settings.shop_name.charAt(0).toUpperCase();
            });
          }

          if (settings.shop_tagline) {
            document.querySelectorAll('.shop-tagline-val').forEach(function(el) {
              el.textContent = settings.shop_tagline;
            });
          }

          if (settings.phone) {
            var cleanPhone = settings.phone.replace(/[^0-9]/g, '');
            document.querySelectorAll('.shop-phone-val').forEach(function(el) {
              el.textContent = settings.phone;
            });
            document.querySelectorAll('.shop-phone-link').forEach(function(el) {
              if (el instanceof HTMLAnchorElement) {
                el.href = 'tel:' + cleanPhone;
              }
            });
          }

          if (settings.zalo) {
            document.querySelectorAll('.shop-zalo-val').forEach(function(el) {
              el.textContent = settings.zalo;
            });
            document.querySelectorAll('.shop-zalo-link').forEach(function(el) {
              if (el instanceof HTMLAnchorElement) {
                var currentHref = el.getAttribute('href') || '';
                if (currentHref.indexOf('text=') !== -1) {
                  try {
                    var u = new URL(currentHref, window.location.origin);
                    var textParam = u.searchParams.get('text') || '';
                    el.href = 'https://zalo.me/' + settings.zalo + '?text=' + encodeURIComponent(textParam);
                  } catch (e) {
                    el.href = 'https://zalo.me/' + settings.zalo;
                  }
                } else {
                  el.href = 'https://zalo.me/' + settings.zalo;
                }
              }
            });
          }

          if (settings.address) {
            document.querySelectorAll('.shop-address-val').forEach(function(el) {
              el.textContent = settings.address;
            });
          }

          if (settings.operating_hours) {
            document.querySelectorAll('.shop-hours-val').forEach(function(el) {
              el.textContent = settings.operating_hours;
            });
          }

          if (settings.google_maps_url) {
            document.querySelectorAll('.shop-maps-link').forEach(function(el) {
              if (el instanceof HTMLAnchorElement) {
                el.href = settings.google_maps_url;
              }
            });
          }

          if (settings.facebook_url) {
            document.querySelectorAll('.shop-facebook-link').forEach(function(el) {
              if (el instanceof HTMLAnchorElement) {
                el.href = settings.facebook_url;
              }
            });
          }

          if (settings.tiktok_url) {
            document.querySelectorAll('.shop-tiktok-link').forEach(function(el) {
              if (el instanceof HTMLAnchorElement) {
                el.href = settings.tiktok_url;
              }
            });
          }

          if (settings.youtube_url) {
            document.querySelectorAll('.shop-youtube-link').forEach(function(el) {
              if (el instanceof HTMLAnchorElement) {
                el.href = settings.youtube_url;
              }
            });
          }

          if (settings.logo_url) {
            document.querySelectorAll('.shop-logo-img').forEach(function(el) {
              if (el instanceof HTMLImageElement) {
                el.src = settings.logo_url;
                el.classList.remove('hidden');
              }
            });
            document.querySelectorAll('.shop-logo-fallback').forEach(function(el) {
              el.classList.add('hidden');
            });
            if (settings.hide_text_logo) {
              document.querySelectorAll('.shop-text-brand').forEach(function(el) {
                el.classList.add('hidden');
              });
            } else {
              document.querySelectorAll('.shop-text-brand').forEach(function(el) {
                el.classList.remove('hidden');
              });
            }
          } else {
            document.querySelectorAll('.shop-logo-img').forEach(function(el) {
              el.classList.add('hidden');
            });
            document.querySelectorAll('.shop-logo-fallback').forEach(function(el) {
              el.classList.remove('hidden');
            });
            document.querySelectorAll('.shop-text-brand').forEach(function(el) {
              el.classList.remove('hidden');
            });
          }
        } catch (e) {
          console.error('Lỗi đồng bộ cấu hình:', e);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncShopSettings);
      } else {
        syncShopSettings();
      }
      window.addEventListener('storage', syncShopSettings);
      window.addEventListener('app-settings-updated', syncShopSettings);
    </script>
  </body>
</html>
