---
import { DEFAULT_SHOP_SETTINGS, NAVIGATION_LINKS } from '@/lib/constants';

interface Props {
  currentPath?: string;
  phone?: string;
  zalo?: string;
  address?: string;
}

const {
  currentPath = Astro.url.pathname,
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
  address = DEFAULT_SHOP_SETTINGS.address,
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
---

<header class="w-full sticky top-0 z-40 bg-white border-b border-slate-200 text-slate-800 shadow-xs">
  <!-- Top Bar Đơn giản nền xám nhạt -->
  <div class="hidden md:block bg-slate-50 border-b border-slate-200 py-1.5 px-4 text-xs text-slate-600">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span>📍 <span class="shop-address-val">{address}</span></span>
        <span>⏰ <span class="shop-hours-val">{DEFAULT_SHOP_SETTINGS.operating_hours}</span></span>
      </div>

      <div class="flex items-center gap-4">
        <!-- Mạng xã hội: Facebook, TikTok, YouTube -->
        <div class="flex items-center gap-3 pr-3 border-r border-slate-200">
          <a
            href={DEFAULT_SHOP_SETTINGS.facebook_url}
            target="_blank"
            rel="noopener noreferrer"
            class="shop-facebook-link text-slate-500 hover:text-blue-600 transition flex items-center gap-1"
            title="Fanpage Facebook"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span class="text-[11px] font-medium hidden lg:inline">Facebook</span>
          </a>

          <a
            href={DEFAULT_SHOP_SETTINGS.tiktok_url}
            target="_blank"
            rel="noopener noreferrer"
            class="shop-tiktok-link text-slate-500 hover:text-slate-900 transition flex items-center gap-1"
            title="Kênh TikTok"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            <span class="text-[11px] font-medium hidden lg:inline">TikTok</span>
          </a>

          <a
            href={DEFAULT_SHOP_SETTINGS.youtube_url}
            target="_blank"
            rel="noopener noreferrer"
            class="shop-youtube-link text-slate-500 hover:text-red-600 transition flex items-center gap-1"
            title="Kênh YouTube"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <span class="text-[11px] font-medium hidden lg:inline">YouTube</span>
          </a>
        </div>

        <a href={`https://zalo.me/${zalo}`} target="_blank" rel="noopener noreferrer" class="shop-zalo-link text-blue-600 hover:text-blue-700 font-semibold">
          Zalo Kỹ Thuật: <span class="shop-zalo-val">{zalo}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    <!-- Logo & Tên shop -->
    <a href="/" class="flex items-center gap-3 sm:gap-4 py-1 group">
      <div class="shop-logo-container flex items-center justify-center">
        <span class={`shop-logo-fallback w-12 h-12 rounded-xl bg-red-600 flex items-center justify-center text-white font-black text-2xl shadow-sm ${DEFAULT_SHOP_SETTINGS.logo_url ? 'hidden' : ''}`}>
          {DEFAULT_SHOP_SETTINGS.shop_name.charAt(0).toUpperCase()}
        </span>
        <img
          src={DEFAULT_SHOP_SETTINGS.logo_url || '/logo.png'}
          alt={DEFAULT_SHOP_SETTINGS.shop_name}
          class={`shop-logo-img h-14 sm:h-16 md:h-18 w-auto max-w-[240px] sm:max-w-[340px] object-contain drop-shadow-xs transition transform group-hover:scale-102 ${DEFAULT_SHOP_SETTINGS.logo_url ? '' : 'hidden'}`}
        />
      </div>
      <div class="shop-text-brand flex flex-col justify-center">
        <div class="shop-name-val font-black text-xl sm:text-2xl md:text-3xl tracking-tight text-slate-900 leading-tight group-hover:text-red-600 transition">
          {DEFAULT_SHOP_SETTINGS.shop_name}
        </div>
        <div class="shop-tagline-val text-[11px] sm:text-xs text-slate-500 font-semibold tracking-wide mt-0.5 hidden sm:block">
          {DEFAULT_SHOP_SETTINGS.shop_tagline}
        </div>
      </div>
    </a>

    <!-- Menu Điều Hướng Desktop -->
    <nav class="hidden lg:flex items-center gap-1 text-xs font-semibold text-slate-700">
      {NAVIGATION_LINKS.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-md transition ${
              isActive
                ? 'text-red-600 bg-red-50 font-bold'
                : 'hover:text-red-600 hover:bg-slate-50'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Nút Hotline & Menu Mobile -->
    <div class="flex items-center gap-2">
      <a
        href={`tel:${cleanPhone}`}
        class="shop-phone-link inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-sm transition active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Hotline: <span class="shop-phone-val">{phone}</span></span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded text-slate-600 hover:text-slate-900 hover:bg-slate-100"
        aria-label="Menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-2 text-xs">
    {NAVIGATION_LINKS.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 rounded text-slate-700 hover:text-red-600 hover:bg-slate-50 font-medium"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-2 border-t border-slate-100 flex gap-2">
      <a href={`tel:${cleanPhone}`} class="shop-phone-link flex-1 py-2 text-center rounded bg-red-600 text-white font-bold">
        Gọi <span class="shop-phone-val">{phone}</span>
      </a>
      <a href={`https://zalo.me/${zalo}`} target="_blank" rel="noopener noreferrer" class="shop-zalo-link flex-1 py-2 text-center rounded bg-blue-600 text-white font-bold">
        Nhắn Zalo
      </a>
    </div>

    <!-- Mạng xã hội Mobile -->
    <div class="pt-2 border-t border-slate-100 flex items-center justify-around text-xs">
      <a href={DEFAULT_SHOP_SETTINGS.facebook_url} target="_blank" rel="noopener noreferrer" class="shop-facebook-link py-1.5 px-2 rounded hover:bg-slate-50 flex items-center gap-1.5 text-blue-600 font-medium">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        <span>Facebook</span>
      </a>
      <a href={DEFAULT_SHOP_SETTINGS.tiktok_url} target="_blank" rel="noopener noreferrer" class="shop-tiktok-link py-1.5 px-2 rounded hover:bg-slate-50 flex items-center gap-1.5 text-slate-800 font-medium">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        <span>TikTok</span>
      </a>
      <a href={DEFAULT_SHOP_SETTINGS.youtube_url} target="_blank" rel="noopener noreferrer" class="shop-youtube-link py-1.5 px-2 rounded hover:bg-slate-50 flex items-center gap-1.5 text-red-600 font-medium">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        <span>YouTube</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
