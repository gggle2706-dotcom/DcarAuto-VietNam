---
import { DEFAULT_SHOP_SETTINGS, NAVIGATION_LINKS } from '@/lib/constants';

interface Props {
  currentPath?: string;
  phone?: string;
  zalo?: string;
  address?: string;
}

const {
  currentPath = Astro.url.pathname,
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
  address = DEFAULT_SHOP_SETTINGS.address,
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
---

<header class="w-full sticky top-0 z-40 bg-white border-b border-slate-200 text-slate-800 shadow-xs">
  <!-- Top Bar Đơn giản nền xám nhạt -->
  <div class="hidden md:block bg-slate-50 border-b border-slate-200 py-1.5 px-4 text-xs text-slate-600">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span>📍 {address}</span>
        <span>⏰ {DEFAULT_SHOP_SETTINGS.operating_hours}</span>
      </div>

      <div class="flex items-center gap-4">
        <span class="text-slate-500">Cắm giắc zin 100% theo xe</span>
        <a href={`https://zalo.me/${zalo}`} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-700 font-semibold">
          Zalo Kỹ Thuật: {zalo}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    <!-- Logo & Tên shop -->
    <a href="/" class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-lg bg-red-600 flex items-center justify-center text-white font-black text-lg shadow-sm">
        A
      </div>
      <div>
        <div class="font-extrabold text-xl tracking-tight text-slate-900 leading-tight">
          {DEFAULT_SHOP_SETTINGS.shop_name}
        </div>
        <div class="text-[11px] text-slate-500 font-medium hidden sm:block">
          {DEFAULT_SHOP_SETTINGS.shop_tagline}
        </div>
      </div>
    </a>

    <!-- Menu Điều Hướng Desktop -->
    <nav class="hidden lg:flex items-center gap-1 text-xs font-semibold text-slate-700">
      {NAVIGATION_LINKS.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-md transition ${
              isActive
                ? 'text-red-600 bg-red-50 font-bold'
                : 'hover:text-red-600 hover:bg-slate-50'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Nút Hotline & Menu Mobile -->
    <div class="flex items-center gap-2">
      <a
        href={`tel:${cleanPhone}`}
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-sm transition active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Hotline: {phone}</span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded text-slate-600 hover:text-slate-900 hover:bg-slate-100"
        aria-label="Menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-2 text-xs">
    {NAVIGATION_LINKS.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 rounded text-slate-700 hover:text-red-600 hover:bg-slate-50 font-medium"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-2 border-t border-slate-100 flex gap-2">
      <a href={`tel:${cleanPhone}`} class="flex-1 py-2 text-center rounded bg-red-600 text-white font-bold">
        Gọi {phone}
      </a>
      <a href={`https://zalo.me/${zalo}`} target="_blank" rel="noopener noreferrer" class="flex-1 py-2 text-center rounded bg-blue-600 text-white font-bold">
        Nhắn Zalo
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
