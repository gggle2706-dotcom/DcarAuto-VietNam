---
import { DEFAULT_SHOP_SETTINGS, NAVIGATION_LINKS } from '@/lib/constants';

interface Props {
  currentPath?: string;
  phone?: string;
  zalo?: string;
  address?: string;
}

const {
  currentPath = Astro.url.pathname,
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
  address = DEFAULT_SHOP_SETTINGS.address,
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
const cleanZalo = zalo.replace(/[^0-9]/g, '');
---

<header class="w-full sticky top-0 z-40 bg-white border-b border-slate-200/90 text-slate-800 shadow-2xs">
  <!-- Top Bar Gọn Gàng Nền Xám Nhạt (Giữ địa chỉ, giờ mở cửa & Zalo, giảm tranh chấp liên kết) -->
  <div class="hidden md:block bg-slate-50 border-b border-slate-200/70 py-1 px-4 text-xs text-slate-600">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6 text-[11px]">
        <span class="flex items-center gap-1.5 text-slate-600">
          <span>📍</span>
          <span class="shop-address-val">{address}</span>
        </span>
        <span class="flex items-center gap-1.5 text-slate-500">
          <span>⏰</span>
          <span class="shop-hours-val">{DEFAULT_SHOP_SETTINGS.operating_hours}</span>
        </span>
      </div>

      <div class="flex items-center gap-4 text-[11px]">
        <span class="text-slate-400">•</span>
        <a
          href={`https://zalo.me/${cleanZalo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="shop-zalo-link text-blue-600 hover:text-blue-700 font-bold transition flex items-center gap-1"
        >
          <span>Zalo Tư Vấn:</span>
          <span class="shop-zalo-val">{zalo}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar (Chiều cao ~60px, Logo cân đối, Menu dễ quét) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2 sm:py-2.5 flex items-center justify-between gap-4">
    <!-- Logo & Tên shop -->
    <a href="/" class="flex items-center gap-3 py-0.5 group shrink-0" title={DEFAULT_SHOP_SETTINGS.shop_name}>
      <div class="shop-logo-container flex items-center justify-center">
        <span class={`shop-logo-fallback w-10 h-10 rounded-xl bg-red-600 flex items-center justify-center text-white font-black text-xl shadow-xs ${DEFAULT_SHOP_SETTINGS.logo_url ? 'hidden' : ''}`}>
          {DEFAULT_SHOP_SETTINGS.shop_name.charAt(0).toUpperCase()}
        </span>
        <img
          src={DEFAULT_SHOP_SETTINGS.logo_url || '/logo.png'}
          alt={DEFAULT_SHOP_SETTINGS.shop_name}
          class={`shop-logo-img h-10 sm:h-12 w-auto max-w-[220px] sm:max-w-[280px] object-contain drop-shadow-2xs transition transform group-hover:scale-101 ${DEFAULT_SHOP_SETTINGS.logo_url ? '' : 'hidden'}`}
        />
      </div>
      <div class={`shop-text-brand flex-col justify-center ${DEFAULT_SHOP_SETTINGS.hide_text_logo ? 'hidden' : 'flex'}`}>
        <div class="shop-name-val font-black text-base sm:text-lg tracking-tight text-slate-900 leading-tight group-hover:text-red-600 transition">
          {DEFAULT_SHOP_SETTINGS.shop_name}
        </div>
        <div class="shop-tagline-val text-[10px] text-slate-500 font-semibold tracking-wide hidden sm:block">
          {DEFAULT_SHOP_SETTINGS.shop_tagline}
        </div>
      </div>
      <h1 class="sr-only">Dcar Auto Vietnam - Phụ Kiện & Đồ Chơi Xe Hơi Chính Hãng</h1>
    </a>

    <!-- Menu Điều Hướng Desktop (Font chuẩn, Khoảng cách đồng nhất) -->
    <nav class="hidden lg:flex items-center gap-1 text-xs font-semibold text-slate-700">
      {NAVIGATION_LINKS.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-lg transition ${
              isActive
                ? 'text-red-600 bg-red-50/80 font-bold border border-red-100 shadow-2xs'
                : 'text-slate-700 hover:text-red-600 hover:bg-slate-50'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Nút Hotline Cân Đối & Menu Mobile -->
    <div class="flex items-center gap-2">
      <a
        href={`tel:${cleanPhone}`}
        class="shop-phone-link inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-xs transition active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span class="hidden sm:inline">Hotline:</span>
        <span class="shop-phone-val">{phone}</span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100"
        aria-label="Mở menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer (Thao tác nhanh bằng một tay) -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-1.5 text-xs">
    {NAVIGATION_LINKS.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`block px-3 py-2 rounded-lg font-medium transition ${
            isActive ? 'bg-red-50 text-red-600 font-bold' : 'text-slate-700 hover:bg-slate-50'
          }`}
        >
          {link.label}
        </a>
      );
    })}

    <div class="pt-2.5 border-t border-slate-100 flex gap-2">
      <a href={`tel:${cleanPhone}`} class="shop-phone-link flex-1 py-2 text-center rounded-lg bg-red-600 text-white font-bold text-xs flex items-center justify-center gap-1.5">
        <span>📞 Gọi {phone}</span>
      </a>
      <a href={`https://zalo.me/${cleanZalo}`} target="_blank" rel="noopener noreferrer" class="shop-zalo-link flex-1 py-2 text-center rounded-lg bg-blue-600 text-white font-bold text-xs flex items-center justify-center gap-1.5">
        <span>💬 Nhắn Zalo</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
