---
import { DEFAULT_SHOP_SETTINGS, NAVIGATION_LINKS } from '@/lib/constants';

interface Props {
  currentPath?: string;
  phone?: string;
  zalo?: string;
  address?: string;
}

const {
  currentPath = Astro.url.pathname,
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
  address = DEFAULT_SHOP_SETTINGS.address,
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
---

<header class="w-full sticky top-0 z-40 bg-neutral-900 border-b border-neutral-800 text-neutral-200">
  <!-- Top Bar đơn giản -->
  <div class="hidden md:block bg-neutral-950 border-b border-neutral-800 py-1.5 px-4 text-xs text-neutral-400">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span>📍 {address}</span>
        <span>⏰ {DEFAULT_SHOP_SETTINGS.operating_hours}</span>
      </div>

      <div class="flex items-center gap-4">
        <span>Cắm giắc zin 100% theo xe</span>
        <a href={`https://zalo.me/${zalo}`} target="_blank" rel="noopener noreferrer" class="text-neutral-200 hover:text-white font-medium">
          Zalo: {zalo}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-4">
    <!-- Logo & Tên cửa hàng -->
    <a href="/" class="flex items-center gap-2">
      <div class="w-8 h-8 rounded bg-red-600 flex items-center justify-center text-white font-black text-base">
        A
      </div>
      <div>
        <div class="font-extrabold text-lg tracking-tight text-white leading-tight">
          {DEFAULT_SHOP_SETTINGS.shop_name}
        </div>
        <div class="text-[10px] text-neutral-400 font-medium hidden sm:block">
          {DEFAULT_SHOP_SETTINGS.shop_tagline}
        </div>
      </div>
    </a>

    <!-- Menu máy tính -->
    <nav class="hidden lg:flex items-center gap-1 text-xs font-semibold text-neutral-300">
      {NAVIGATION_LINKS.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-2 rounded transition ${
              isActive
                ? 'text-white bg-neutral-800'
                : 'hover:text-white hover:bg-neutral-800/60'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Nút Hotline -->
    <div class="flex items-center gap-2">
      <a
        href={`tel:${cleanPhone}`}
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded bg-red-600 hover:bg-red-500 text-white font-bold text-xs transition"
      >
        <span>📞</span>
        <span>Hotline: {phone}</span>
      </a>

      <!-- Nút mở Menu Mobile -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded text-neutral-400 hover:text-white hover:bg-neutral-800"
        aria-label="Menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-800 bg-neutral-900 px-4 py-3 space-y-2 text-xs">
    {NAVIGATION_LINKS.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 rounded text-neutral-300 hover:text-white hover:bg-neutral-800 font-medium"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-2 border-t border-neutral-800 flex gap-2">
      <a href={`tel:${cleanPhone}`} class="flex-1 py-2 text-center rounded bg-red-600 text-white font-bold">
        Gọi {phone}
      </a>
      <a href={`https://zalo.me/${zalo}`} target="_blank" rel="noopener noreferrer" class="flex-1 py-2 text-center rounded bg-blue-600 text-white font-bold">
        Nhắn Zalo
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
