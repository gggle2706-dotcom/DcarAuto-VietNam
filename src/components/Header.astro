---
import { DEFAULT_SHOP_SETTINGS, NAVIGATION_LINKS, CATEGORIES_LIST } from '@/lib/constants';

interface Props {
  currentPath?: string;
  phone?: string;
  zalo?: string;
  address?: string;
}

const {
  currentPath = Astro.url.pathname,
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
  address = DEFAULT_SHOP_SETTINGS.address,
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
---

<header class="w-full sticky top-0 z-40 bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80">
  <!-- Top Bar: Thông tin xưởng (Ẩn trên mobile để tiết kiệm diện tích) -->
  <div class="hidden md:block bg-slate-900/60 border-b border-slate-800/40 py-1.5 px-4 sm:px-6 text-xs text-slate-400">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span class="inline-flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          {address}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {DEFAULT_SHOP_SETTINGS.operating_hours}
        </span>
      </div>

      <div class="flex items-center gap-4">
        <span class="text-slate-300">Cắm giắc zin 100% - Bảo hành chính hãng</span>
        <a href={`https://zalo.me/${zalo}`} target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300 font-medium inline-flex items-center gap-1">
          <span>Zalo Kỹ Thuật: {zalo}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    <!-- Logo & Brand Name -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-red-600 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg shadow-amber-500/20 group-hover:scale-105 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-slate-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
          <circle cx="7" cy="17" r="2"></circle>
          <path d="M9 17h6"></path>
          <circle cx="17" cy="17" r="2"></circle>
        </svg>
      </div>
      <div>
        <div class="font-extrabold text-lg sm:text-xl tracking-tight text-white flex items-center gap-1">
          {DEFAULT_SHOP_SETTINGS.shop_name}
          <span class="text-xs px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30 font-semibold uppercase">PRO</span>
        </div>
        <div class="text-[11px] text-slate-400 font-medium hidden sm:block">
          Nội Thất & Đồ Chơi Công Nghệ Ô Tô
        </div>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 text-sm font-medium text-slate-300">
      {NAVIGATION_LINKS.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-lg transition ${
              isActive
                ? 'text-amber-400 bg-slate-900 font-semibold'
                : 'hover:text-white hover:bg-slate-900/60'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions: Search trigger & Hotline button & Mobile Toggle -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Hotline Button (Desktop & Tablet) -->
      <a
        href={`tel:${cleanPhone}`}
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-red-600 hover:bg-red-500 text-white font-semibold text-sm shadow-md shadow-red-600/20 transition active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>{phone}</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-900 focus:outline-none"
        aria-label="Mở menu điều hướng"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Collapsible) -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-slate-950 px-4 pt-3 pb-6 space-y-3">
    <div class="space-y-1">
      {NAVIGATION_LINKS.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-900"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile Danh mục nhanh -->
    <div class="pt-3 border-t border-slate-800">
      <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider px-3 mb-2">
        Danh mục nâng cấp nổi bật
      </div>
      <div class="grid grid-cols-2 gap-1 text-sm">
        {CATEGORIES_LIST.slice(0, 6).map((cat) => (
          <a href={`/danh-muc/${cat.slug}`} class="px-3 py-1.5 rounded text-slate-400 hover:text-amber-400 hover:bg-slate-900 truncate">
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile Hotline & Zalo Box -->
    <div class="pt-3 border-t border-slate-800 flex gap-2">
      <a href={`tel:${cleanPhone}`} class="flex-1 py-2.5 text-center rounded-lg bg-red-600 text-white font-semibold text-sm">
        Gọi {phone}
      </a>
      <a href={`https://zalo.me/${zalo}`} target="_blank" rel="noopener noreferrer" class="flex-1 py-2.5 text-center rounded-lg bg-blue-600 text-white font-semibold text-sm">
        Chat Zalo
      </a>
    </div>
  </div>
</header>

<script>
  // Script xử lý bật tắt mobile menu
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
