---
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';

interface Props {
  id: string;
  slug: string;
  name: string;
  brand: string;
  categoryName?: string;
  price: number;
  salePrice?: number | null;
  image: string;
  specs?: string[];
  warrantyMonths?: number;
  isUniversal?: boolean;
}

const {
  slug,
  name,
  brand,
  categoryName,
  price,
  salePrice,
  image,
  specs = [],
  warrantyMonths = 12,
  isUniversal = false,
} = Astro.props;

const hasDiscount = salePrice && salePrice < price;
const currentPrice = hasDiscount ? salePrice : price;

// Tin nhắn Zalo
const zaloMessage = encodeURIComponent(`Xin chào, tôi cần tư vấn sản phẩm: ${name} (${brand}). Cho tôi xin báo giá thi công cho xe.`);
const zaloUrl = `https://zalo.me/${DEFAULT_SHOP_SETTINGS.zalo}?text=${zaloMessage}`;
---

<div class="flex flex-col rounded-lg bg-neutral-900 border border-neutral-800 hover:border-neutral-700 transition overflow-hidden">
  <!-- Ảnh sản phẩm -->
  <a href={`/san-pham/${slug}`} class="relative aspect-[4/3] bg-neutral-950 overflow-hidden block">
    <img
      src={image}
      alt={name}
      loading="lazy"
      class="w-full h-full object-cover hover:scale-102 transition duration-300"
    />

    {hasDiscount && (
      <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-600 text-white">
        Giảm giá
      </span>
    )}

    {isUniversal && (
      <span class="absolute bottom-2 left-2 px-1.5 py-0.5 rounded text-[10px] bg-neutral-900/90 text-neutral-300 border border-neutral-700">
        Mọi dòng xe
      </span>
    )}
  </a>

  <!-- Nội dung -->
  <div class="p-3.5 flex-1 flex flex-col justify-between text-xs">
    <div>
      <div class="text-[11px] text-neutral-400 mb-1 flex items-center justify-between">
        <span class="font-semibold text-neutral-300">{brand}</span>
        {categoryName && <span class="text-neutral-500">{categoryName}</span>}
      </div>

      <h3 class="font-bold text-white text-sm line-clamp-2 hover:text-red-400 transition mb-2">
        <a href={`/san-pham/${slug}`}>{name}</a>
      </h3>

      {specs.length > 0 && (
        <div class="text-[11px] text-neutral-400 space-y-0.5 mb-3">
          {specs.slice(0, 2).map((s) => (
            <div class="line-clamp-1">• {s}</div>
          ))}
        </div>
      )}
    </div>

    <!-- Giá & Nút hành động -->
    <div class="pt-3 border-t border-neutral-800">
      <div class="mb-2.5">
        {currentPrice > 0 ? (
          <div class="flex items-baseline gap-2">
            <span class="text-sm sm:text-base font-extrabold text-white">
              {currentPrice.toLocaleString('vi-VN')} đ
            </span>
            {hasDiscount && (
              <span class="text-[11px] text-neutral-500 line-through">
                {price.toLocaleString('vi-VN')} đ
              </span>
            )}
          </div>
        ) : (
          <span class="text-sm font-bold text-neutral-300">Liên hệ báo giá</span>
        )}
      </div>

      <div class="grid grid-cols-2 gap-1.5 text-xs">
        <a
          href={`/san-pham/${slug}`}
          class="py-1.5 text-center rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-medium transition"
        >
          Xem chi tiết
        </a>
        <a
          href={zaloUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="py-1.5 text-center rounded bg-blue-600 hover:bg-blue-500 text-white font-medium transition"
        >
          Nhắn Zalo
        </a>
      </div>
    </div>
  </div>
</div>
