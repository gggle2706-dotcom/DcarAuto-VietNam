---
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';

interface Props {
  id: string;
  slug: string;
  name: string;
  brand: string;
  categoryName?: string;
  price: number;
  salePrice?: number | null;
  image: string;
  specs?: string[];
  warrantyMonths?: number;
  isUniversal?: boolean;
}

const {
  slug,
  name,
  brand,
  categoryName,
  price,
  salePrice,
  image,
  specs = [],
  isUniversal = false,
} = Astro.props;

const hasDiscount = salePrice && salePrice < price;
const currentPrice = hasDiscount ? salePrice : price;

// Tin nhắn Zalo tư vấn
const cleanZalo = DEFAULT_SHOP_SETTINGS.zalo.replace(/[^0-9]/g, '');
const zaloMessage = encodeURIComponent(
  `Chào Dcar Auto, tôi cần tư vấn & báo giá trọn gói lắp đặt sản phẩm "${name}" (Thương hiệu: ${brand}).`
);
const zaloUrl = `https://zalo.me/${cleanZalo}?text=${zaloMessage}`;
---

<div class="flex flex-col rounded-2xl bg-white border border-slate-200/90 hover:border-slate-300 hover:shadow-md transition overflow-hidden group">
  <!-- Ảnh sản phẩm tỷ lệ 4:3 chuẩn nét -->
  <a href={`/san-pham/${slug}`} class="relative aspect-[4/3] bg-slate-50 overflow-hidden block border-b border-slate-100">
    <img
      src={image}
      alt={name}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-102 transition duration-300"
    />

    {hasDiscount && (
      <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded text-[10px] font-black bg-red-600 text-white shadow-2xs tracking-wider">
        GIẢM GIÁ
      </span>
    )}

    <span class="absolute bottom-2.5 left-2.5 px-2 py-0.5 rounded text-[10px] bg-white/95 text-emerald-700 font-bold border border-slate-200 shadow-2xs">
      ✓ Cắm Giắc Zin
    </span>
  </a>

  <!-- Thông tin sản phẩm -->
  <div class="p-4 flex-1 flex flex-col justify-between text-xs">
    <div>
      <div class="text-[11px] text-slate-500 mb-1.5 flex items-center justify-between">
        <span class="font-extrabold text-red-600 uppercase tracking-wider">{brand}</span>
        {categoryName && <span class="text-slate-400 font-medium truncate max-w-[120px]">{categoryName}</span>}
      </div>

      <h3 class="font-bold text-slate-900 text-sm line-clamp-2 group-hover:text-red-600 transition mb-2 leading-snug">
        <a href={`/san-pham/${slug}`}>{name}</a>
      </h3>

      {specs.length > 0 && (
        <div class="flex flex-wrap gap-1 mb-3">
          {specs.slice(0, 2).map((s) => (
            <span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-medium">
              {s}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Giá & 2 Nút hành động rõ ràng -->
    <div class="pt-3 border-t border-slate-100 mt-auto">
      <div class="mb-3">
        {currentPrice > 0 ? (
          <div class="flex items-baseline gap-2">
            <span class="text-base sm:text-lg font-black text-red-600">
              {currentPrice.toLocaleString('vi-VN')} đ
            </span>
            {hasDiscount && (
              <span class="text-xs text-slate-400 line-through">
                {price.toLocaleString('vi-VN')} đ
              </span>
            )}
          </div>
        ) : (
          <span class="text-sm font-bold text-slate-700">Liên hệ báo giá</span>
        )}
      </div>

      <div class="grid grid-cols-2 gap-2 text-xs">
        <a
          href={`/san-pham/${slug}`}
          class="py-2 text-center rounded-lg bg-white hover:bg-slate-50 text-slate-800 font-semibold border border-slate-200 hover:border-slate-300 transition"
        >
          Xem chi tiết
        </a>
        <a
          href={zaloUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="py-2 text-center rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold transition shadow-2xs"
        >
          Tư vấn Zalo
        </a>
      </div>
    </div>
  </div>
</div>
