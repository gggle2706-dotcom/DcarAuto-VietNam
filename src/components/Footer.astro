---
import { DEFAULT_SHOP_SETTINGS, CATEGORIES_LIST, NAVIGATION_LINKS } from '@/lib/constants';

interface Props {
  shopName?: string;
  phone?: string;
  zalo?: string;
  address?: string;
}

const {
  shopName = DEFAULT_SHOP_SETTINGS.shop_name,
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
  address = DEFAULT_SHOP_SETTINGS.address,
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-100 border-t border-slate-200 text-slate-600 text-xs mt-auto pb-16 sm:pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    <!-- Cột 1: Thông tin liên hệ -->
    <div class="space-y-3">
      <div class="flex items-center gap-3">
        <div class="shop-logo-container flex items-center justify-center">
          <span class="shop-logo-fallback w-10 h-10 rounded-lg bg-red-600 flex items-center justify-center text-white font-black text-lg shadow-2xs">
            {shopName.charAt(0).toUpperCase()}
          </span>
          <img
            src=""
            alt={shopName}
            class="shop-logo-img h-12 w-auto max-w-[180px] object-contain hidden"
          />
        </div>
        <div class="shop-text-brand shop-name-val font-extrabold text-base text-slate-900 leading-tight">
          {shopName}
        </div>
      </div>
      <p class="shop-tagline-val text-slate-500 leading-relaxed text-xs">
        {DEFAULT_SHOP_SETTINGS.shop_tagline}. Chuyên lắp đặt phụ kiện, đồ chơi xe hơi chuẩn giắc zin 100%.
      </p>
      <div class="space-y-1.5 pt-1 text-slate-700">
        <div>Hotline: <a href={`tel:${phone.replace(/[^0-9]/g, '')}`} class="shop-phone-link text-red-600 font-bold"><span class="shop-phone-val">{phone}</span></a></div>
        <div>Zalo: <a href={`https://zalo.me/${zalo}`} target="_blank" rel="noopener noreferrer" class="shop-zalo-link text-blue-600 font-bold"><span class="shop-zalo-val">{zalo}</span></a></div>
        <div>Địa chỉ: <span class="shop-address-val">{address}</span></div>
        <div>Giờ làm việc: <span class="shop-hours-val">{DEFAULT_SHOP_SETTINGS.operating_hours}</span></div>
      </div>

      <!-- Mạng xã hội: Facebook, TikTok, YouTube -->
      <div class="pt-2 flex items-center gap-2">
        <a
          href={DEFAULT_SHOP_SETTINGS.facebook_url}
          target="_blank"
          rel="noopener noreferrer"
          class="shop-facebook-link w-8 h-8 rounded-lg bg-white border border-slate-300 hover:border-blue-600 hover:text-blue-600 flex items-center justify-center text-slate-600 transition shadow-2xs"
          title="Facebook Fanpage"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>

        <a
          href={DEFAULT_SHOP_SETTINGS.tiktok_url}
          target="_blank"
          rel="noopener noreferrer"
          class="shop-tiktok-link w-8 h-8 rounded-lg bg-white border border-slate-300 hover:border-slate-900 hover:text-slate-900 flex items-center justify-center text-slate-600 transition shadow-2xs"
          title="Kênh TikTok"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>

        <a
          href={DEFAULT_SHOP_SETTINGS.youtube_url}
          target="_blank"
          rel="noopener noreferrer"
          class="shop-youtube-link w-8 h-8 rounded-lg bg-white border border-slate-300 hover:border-red-600 hover:text-red-600 flex items-center justify-center text-slate-600 transition shadow-2xs"
          title="Kênh YouTube"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>

    <!-- Cột 2: Danh mục sản phẩm -->
    <div>
      <div class="font-bold text-slate-900 uppercase tracking-wider mb-3">
        Danh Mục Sản Phẩm
      </div>
      <ul class="space-y-2">
        {CATEGORIES_LIST.slice(0, 6).map((cat) => (
          <li>
            <a href={`/san-pham?category=${cat.slug}`} class="text-slate-600 hover:text-red-600 transition">
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Cột 3: Liên kết nhanh -->
    <div>
      <div class="font-bold text-slate-900 uppercase tracking-wider mb-3">
        Thông Tin Hỗ Trợ
      </div>
      <ul class="space-y-2">
        {NAVIGATION_LINKS.map((link) => (
          <li>
            <a href={link.href} class="text-slate-600 hover:text-red-600 transition">
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/gioi-thieu" class="text-slate-600 hover:text-red-600 transition">Chính sách bảo hành</a>
        </li>
      </ul>
    </div>

    <!-- Cột 4: Chỉ đường Google Maps -->
    <div class="space-y-3">
      <div class="font-bold text-slate-900 uppercase tracking-wider mb-3">
        Vị Trí Cửa Hàng
      </div>
      <p class="text-slate-500">
        Khách hàng có thể mang xe qua xưởng để được kiểm tra dưỡng taplo và tư vấn trực tiếp:
      </p>
      <a
        href={DEFAULT_SHOP_SETTINGS.google_maps_url}
        target="_blank"
        rel="noopener noreferrer"
        class="shop-maps-link inline-block py-2.5 px-4 rounded-lg bg-white border border-slate-300 text-slate-800 hover:border-red-500 hover:text-red-600 transition font-semibold shadow-2xs"
      >
        📍 Xem vị trí trên Google Maps
      </a>
    </div>
  </div>

  <div class="border-t border-slate-200 max-w-7xl mx-auto px-4 sm:px-6 pt-6 text-center text-slate-400">
    © {currentYear} <span class="shop-name-val">{shopName}</span>. Bản quyền thuộc về chủ cửa hàng.
  </div>
</footer>
