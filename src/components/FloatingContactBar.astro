---
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';

interface Props {
  phone?: string;
  zalo?: string;
  mapsUrl?: string;
}

const {
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
  mapsUrl = DEFAULT_SHOP_SETTINGS.google_maps_url,
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
---

<!-- Floating Contact Bar cho Mobile (Cố định ở đáy màn hình) -->
<aside aria-label="Thanh liên hệ nhanh" class="fixed bottom-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur-md border-t border-slate-800 p-2.5 sm:hidden flex items-center justify-around gap-2 shadow-2xl">
  <!-- Gọi điện -->
  <a
    href={`tel:${cleanPhone}`}
    class="flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium text-xs shadow-md shadow-red-600/20 active:scale-95 transition"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span>Gọi Ngay</span>
  </a>

  <!-- Chat Zalo -->
  <a
    href={`https://zalo.me/${zalo}`}
    target="_blank"
    rel="noopener noreferrer"
    class="flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs shadow-md shadow-blue-600/20 active:scale-95 transition"
  >
    <span class="font-bold text-xs bg-white text-blue-600 px-1 rounded">Z</span>
    <span>Chat Zalo</span>
  </a>

  <!-- Chỉ đường Google Maps -->
  <a
    href={mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center py-2 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium text-xs border border-slate-700 active:scale-95 transition"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
    </svg>
    <span>Chỉ Đường</span>
  </a>
</aside>

<!-- Floating Desktop Buttons (Góc dưới bên phải màn hình lớn) -->
<aside aria-label="Nút liên hệ màn hình lớn" class="hidden sm:flex fixed bottom-6 right-6 z-50 flex-col gap-3">
  <!-- Zalo Desktop -->
  <a
    href={`https://zalo.me/${zalo}`}
    target="_blank"
    rel="noopener noreferrer"
    class="group relative flex items-center justify-center w-13 h-13 rounded-full bg-blue-600 hover:bg-blue-500 text-white shadow-xl shadow-blue-600/30 hover:scale-105 transition"
    title="Chat qua Zalo tư vấn kỹ thuật"
  >
    <span class="font-extrabold text-sm">Zalo</span>
    <span class="absolute right-15 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-200 text-xs font-medium whitespace-nowrap opacity-0 group-hover:opacity-100 transition shadow-lg pointer-events-none">
      Tư vấn kỹ thuật Zalo
    </span>
  </a>

  <!-- Hotline Desktop -->
  <a
    href={`tel:${cleanPhone}`}
    class="group relative flex items-center justify-center w-13 h-13 rounded-full bg-red-600 hover:bg-red-500 text-white shadow-xl shadow-red-600/30 hover:scale-105 transition animate-bounce"
    title="Gọi Hotline tư vấn trực tiếp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span class="absolute right-15 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-200 text-xs font-medium whitespace-nowrap opacity-0 group-hover:opacity-100 transition shadow-lg pointer-events-none">
      Hotline: {phone}
    </span>
  </a>
</aside>
