---
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';

interface Props {
  phone?: string;
  zalo?: string;
  mapsUrl?: string;
  facebookUrl?: string;
  tiktokUrl?: string;
  youtubeUrl?: string;
}

const {
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
  mapsUrl = DEFAULT_SHOP_SETTINGS.google_maps_url,
  facebookUrl = DEFAULT_SHOP_SETTINGS.facebook_url,
  tiktokUrl = DEFAULT_SHOP_SETTINGS.tiktok_url,
  youtubeUrl = DEFAULT_SHOP_SETTINGS.youtube_url,
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
---

<!-- Floating Contact Bar cho Mobile (Cố định đáy màn hình) -->
<aside aria-label="Thanh liên hệ nhanh" class="fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 p-2 sm:hidden flex items-center justify-around gap-2 shadow-lg">
  <!-- Gọi điện -->
  <a
    href={`tel:${cleanPhone}`}
    class="shop-phone-link flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-xs active:scale-95 transition"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span>Gọi <span class="shop-phone-val">{phone}</span></span>
  </a>

  <!-- Chat Zalo -->
  <a
    href={`https://zalo.me/${zalo}`}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-zalo-link flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-xs active:scale-95 transition"
  >
    <span class="font-bold text-xs bg-white text-blue-600 px-1 rounded">Z</span>
    <span>Chat Zalo</span>
  </a>

  <!-- Chỉ đường Google Maps -->
  <a
    href={mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-maps-link flex items-center justify-center py-2 px-3 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs border border-slate-200 active:scale-95 transition"
  >
    <span>📍 Bản Đồ</span>
  </a>
</aside>

<!-- Floating Action Buttons (Dọc góc phải màn hình: YouTube, TikTok, Facebook, Zalo, Hotline) -->
<aside aria-label="Nút mạng xã hội và liên hệ nổi" class="fixed bottom-20 sm:bottom-6 right-3 sm:right-6 z-50 flex flex-col gap-2.5 sm:gap-3 items-center">
  <!-- YouTube (Nút tròn đỏ) -->
  <a
    href={youtubeUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-youtube-link flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#FF0000] hover:bg-[#CC0000] text-white shadow-lg hover:scale-110 active:scale-95 transition-transform duration-200"
    title="Xem video xưởng trên YouTube"
  >
    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
  </a>

  <!-- TikTok (Nút tròn đen) -->
  <a
    href={tiktokUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-tiktok-link flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-black hover:bg-slate-900 text-white shadow-lg hover:scale-110 active:scale-95 transition-transform duration-200 border border-slate-700"
    title="Xem video ngắn trên TikTok"
  >
    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
  </a>

  <!-- Facebook (Nút tròn xanh FB) -->
  <a
    href={facebookUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-facebook-link flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#1877F2] hover:bg-[#166FE5] text-white shadow-lg hover:scale-110 active:scale-95 transition-transform duration-200"
    title="Trang Fanpage Facebook"
  >
    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
  </a>

  <!-- Zalo (Nút tròn xanh Zalo) -->
  <a
    href={`https://zalo.me/${zalo}`}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-zalo-link flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#0068FF] hover:bg-[#0052cc] text-white shadow-lg hover:scale-110 active:scale-95 transition-transform duration-200 font-black text-xs tracking-tight"
    title="Tư vấn nhanh qua Zalo"
  >
    Zalo
  </a>

  <!-- Hotline (Nút tròn đỏ có vòng sóng nhẹ) -->
  <div class="relative">
    <span class="absolute inset-0 rounded-full bg-red-500 animate-ping opacity-35"></span>
    <a
      href={`tel:${cleanPhone}`}
      class="shop-phone-link relative flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-red-600 hover:bg-red-700 text-white shadow-lg hover:scale-110 active:scale-95 transition-transform duration-200"
      title={`Gọi hotline: ${phone}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
    </a>
  </div>
</aside>
