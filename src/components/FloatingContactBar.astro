---
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';

interface Props {
  phone?: string;
  zalo?: string;
  facebookUrl?: string;
  tiktokUrl?: string;
  youtubeUrl?: string;
}

const {
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
  facebookUrl = DEFAULT_SHOP_SETTINGS.facebook_url,
  tiktokUrl = DEFAULT_SHOP_SETTINGS.tiktok_url,
  youtubeUrl = DEFAULT_SHOP_SETTINGS.youtube_url,
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
const cleanZalo = zalo.replace(/[^0-9]/g, '');
---

<!-- 1. THANH LIÊN HỆ ĐÁY CHO MOBILE (Cố định, tiện thao tác) -->
<aside aria-label="Liên hệ nhanh di động" class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/90 py-1.5 px-3 sm:hidden flex items-center gap-2 shadow-md">
  <!-- Gọi điện ngay -->
  <a
    href={`tel:${cleanPhone}`}
    class="shop-phone-link flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-2xs active:scale-95 transition"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
      <path d="M20 15.5c-1.2 0-2.4-.2-3.6-.6-.3-.1-.7 0-1 .2l-2.2 2.2c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c.3-.3.4-.7.2-1-.4-1.1-.6-2.3-.6-3.5 0-.6-.4-1-1-1H4c-.6 0-1 .4-1 1 0 9.4 7.6 17 17 17 .6 0 1-.4 1-1v-3.5c0-.6-.4-1-1-1z"/>
    </svg>
    <span>Gọi {phone}</span>
  </a>

  <!-- Chat Zalo -->
  <a
    href={`https://zalo.me/${cleanZalo}`}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-zalo-link flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-[#0068FF] hover:bg-[#0052cc] text-white font-bold text-xs shadow-2xs active:scale-95 transition"
  >
    <span class="w-4 h-4 rounded-full bg-white text-[#0068FF] font-black text-[10px] flex items-center justify-center leading-none">
      Z
    </span>
    <span>Chat Zalo 24/7</span>
  </a>
</aside>

<!-- 2. CỤM NÚT NỔI BÊN PHẢI (YOUTUBE, TIKTOK, FACEBOOK, ZALO, HOTLINE) -->
<aside aria-label="Mạng xã hội và liên hệ nhanh" class="fixed bottom-16 sm:bottom-6 right-3 sm:right-6 z-40 flex flex-col gap-2 items-end">
  <!-- YouTube (Nút tròn đỏ) -->
  <a
    href={youtubeUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-youtube-link flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[#FF0000] hover:bg-[#CC0000] text-white shadow-md hover:scale-110 active:scale-95 transition-transform"
    title="Kênh YouTube Dcar Auto"
  >
    <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
  </a>

  <!-- TikTok (Nút tròn đen) -->
  <a
    href={tiktokUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-tiktok-link flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black hover:bg-slate-900 text-white shadow-md hover:scale-110 active:scale-95 transition-transform border border-slate-700"
    title="Kênh TikTok Dcar Auto"
  >
    <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
  </a>

  <!-- Facebook (Nút tròn xanh FB) -->
  <a
    href={facebookUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-facebook-link flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[#1877F2] hover:bg-[#166FE5] text-white shadow-md hover:scale-110 active:scale-95 transition-transform"
    title="Fanpage Facebook Dcar Auto"
  >
    <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
  </a>

  <!-- Zalo Kỹ Thuật (Nút tròn xanh Zalo) -->
  <a
    href={`https://zalo.me/${cleanZalo}`}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-zalo-link flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[#0068FF] hover:bg-[#0052cc] text-white shadow-lg hover:scale-110 active:scale-95 transition-transform font-black text-xs"
    title="Nhắn Zalo Kỹ Thuật Viên"
  >
    Zalo
  </a>

  <!-- Hotline (Nút tròn đỏ điện thoại) -->
  <a
    href={`tel:${cleanPhone}`}
    class="shop-phone-link flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-red-600 hover:bg-red-700 text-white shadow-lg hover:scale-110 active:scale-95 transition-transform"
    title={`Gọi Hotline: ${phone}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
      <path d="M20 15.5c-1.2 0-2.4-.2-3.6-.6-.3-.1-.7 0-1 .2l-2.2 2.2c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c.3-.3.4-.7.2-1-.4-1.1-.6-2.3-.6-3.5 0-.6-.4-1-1-1H4c-.6 0-1 .4-1 1 0 9.4 7.6 17 17 17 .6 0 1-.4 1-1v-3.5c0-.6-.4-1-1-1z"/>
    </svg>
  </a>
</aside>
