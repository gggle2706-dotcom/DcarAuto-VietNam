---
import { DEFAULT_SHOP_SETTINGS } from '@/lib/constants';

interface Props {
  phone?: string;
  zalo?: string;
}

const {
  phone = DEFAULT_SHOP_SETTINGS.phone,
  zalo = DEFAULT_SHOP_SETTINGS.zalo,
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
const cleanZalo = zalo.replace(/[^0-9]/g, '');
---

<!-- 1. THANH LIÊN HỆ ĐÁY CHO MOBILE (Cố định, không che khuất thao tác) -->
<aside aria-label="Liên hệ nhanh di động" class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/90 py-1.5 px-3 sm:hidden flex items-center gap-2 shadow-md">
  <!-- Gọi điện ngay -->
  <a
    href={`tel:${cleanPhone}`}
    class="shop-phone-link flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-2xs active:scale-95 transition"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
      <path d="M20 15.5c-1.2 0-2.4-.2-3.6-.6-.3-.1-.7 0-1 .2l-2.2 2.2c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c.3-.3.4-.7.2-1-.4-1.1-.6-2.3-.6-3.5 0-.6-.4-1-1-1H4c-.6 0-1 .4-1 1 0 9.4 7.6 17 17 17 .6 0 1-.4 1-1v-3.5c0-.6-.4-1-1-1z"/>
    </svg>
    <span>Gọi {phone}</span>
  </a>

  <!-- Chat Zalo -->
  <a
    href={`https://zalo.me/${cleanZalo}`}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-zalo-link flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-[#0068FF] hover:bg-[#0052cc] text-white font-bold text-xs shadow-2xs active:scale-95 transition"
  >
    <span class="w-4 h-4 rounded-full bg-white text-[#0068FF] font-black text-[10px] flex items-center justify-center leading-none">
      Z
    </span>
    <span>Chat Zalo 24/7</span>
  </a>
</aside>

<!-- 2. NÚT LIÊN HỆ NỔI DESKTOP (TINH GỌN, CHỈ GIỮ ZALO & HOTLINE, KHÔNG CHE NỘI DUNG) -->
<aside aria-label="Liên hệ nhanh" class="hidden sm:flex fixed bottom-6 right-6 z-30 flex-col gap-2 items-end">
  <!-- Nút Zalo Kỹ Thuật Viên -->
  <a
    href={`https://zalo.me/${cleanZalo}`}
    target="_blank"
    rel="noopener noreferrer"
    class="shop-zalo-link group flex items-center gap-2 pl-3 pr-4 py-2 rounded-full bg-white border border-slate-200 text-slate-800 hover:border-blue-400 hover:text-blue-600 shadow-md transition transform hover:-translate-y-0.5"
    title="Nhắn Zalo Kỹ Thuật Viên"
  >
    <div class="relative">
      <div class="w-7 h-7 rounded-full bg-[#0068FF] text-white flex items-center justify-center font-black text-xs shadow-2xs">
        Z
      </div>
      <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-500 border border-white"></span>
    </div>
    <div class="text-left">
      <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider leading-none">Tư vấn trực tiếp</div>
      <div class="text-xs font-bold text-[#0068FF] leading-tight">Zalo Kỹ Thuật</div>
    </div>
  </a>

  <!-- Nút Hotline Nhanh -->
  <a
    href={`tel:${cleanPhone}`}
    class="shop-phone-link group flex items-center gap-2 pl-3 pr-4 py-2 rounded-full bg-red-600 text-white hover:bg-red-700 shadow-md transition transform hover:-translate-y-0.5 active:scale-95"
    title="Gọi Hotline Dcar Auto"
  >
    <div class="w-7 h-7 rounded-full bg-white/20 text-white flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
        <path d="M20 15.5c-1.2 0-2.4-.2-3.6-.6-.3-.1-.7 0-1 .2l-2.2 2.2c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c.3-.3.4-.7.2-1-.4-1.1-.6-2.3-.6-3.5 0-.6-.4-1-1-1H4c-.6 0-1 .4-1 1 0 9.4 7.6 17 17 17 .6 0 1-.4 1-1v-3.5c0-.6-.4-1-1-1z"/>
      </svg>
    </div>
    <div class="text-left">
      <div class="text-[10px] font-semibold text-red-100 uppercase tracking-wider leading-none">Hotline hỗ trợ</div>
      <div class="text-xs font-black text-white leading-tight">{phone}</div>
    </div>
  </a>
</aside>
